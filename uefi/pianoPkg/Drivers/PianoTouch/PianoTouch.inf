## @file
#  Novatek touch path probe for the Xiaomi Pad 8 Pro (piano, SM8750).
#
#  Reads the GENI serial engine at 0x0A88000 (the panel's touch SPI) and the
#  TLMM line the panel pulls for its interrupt, and reports both on the console.
#  It programs nothing, so a failed probe never affects the boot.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = PianoTouch
  FILE_GUID                      = 7C1F3A94-2D8B-4E62-9A57-3F0B6E2C8D15
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = PianoTouchInitialize

[Sources]
  PianoTouch.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  DebugLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Depex]
  TRUE
